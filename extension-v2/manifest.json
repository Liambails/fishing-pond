{
  "manifest_version": 3,
  "name": "COBALT Capture",
  "version": "3.9.10",
  "description": "One-click manual capture/recovery for supported marketplace listings, stored in COBALT.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.trademe.co.nz/*",
    "http://127.0.0.1:8765/*",
    "https://*/*",
    "https://fishing-pond-seven.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.trademe.co.nz/*"
      ],
      "js": [
        "collector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "COBALT"
  },
  "commands": {
    "capture-current-listing": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Capture current Trade Me listing"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
